<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Resources\AppIcon.ico</ApplicationIcon>
    <Version>1.3.0</Version>
    <AssemblyVersion>1.3.0.0</AssemblyVersion>
    <FileVersion>1.3.0.0</FileVersion>
    <InformationalVersion>1.3.0</InformationalVersion>

    <AcpiNativeArchitecture Condition="'$(RuntimeIdentifier)' == 'win-arm64' or '$(PlatformTarget)' == 'ARM64'">ARM64</AcpiNativeArchitecture>
    <AcpiNativeArchitecture Condition="'$(AcpiNativeArchitecture)' == ''">x64</AcpiNativeArchitecture>
    <AcpiNativeConfiguration Condition="Exists('..\..\third_party\acpica\integration\bin\$(AcpiNativeArchitecture)\$(Configuration)\AcpiCompilerHost.dll')">$(Configuration)</AcpiNativeConfiguration>
    <AcpiNativeConfiguration Condition="'$(AcpiNativeConfiguration)' == ''">Release</AcpiNativeConfiguration>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AvalonEdit" Version="6.3.1.120" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Form1.cs;Form1.Designer.cs;Program.cs" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Resources\ASL.xshd" />
    <Resource Include="Resources\AppIcon.ico" />
    <Resource Include="Resources\AppIcon.png" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\third_party\acpica\integration\bin\$(AcpiNativeArchitecture)\$(AcpiNativeConfiguration)\AcpiCompilerHost.dll" Link="AcpiCompilerHost.dll" Condition="Exists('..\..\third_party\acpica\integration\bin\$(AcpiNativeArchitecture)\$(AcpiNativeConfiguration)\AcpiCompilerHost.dll')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

</Project>
